<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Регулярная грамматика для строк над алфавитом {a,b,c}, содержащих ровно одну букву a -->
<structure>
  <type>grammar</type>
  <production><left>S</left><right>bS</right></production>
  <production><left>S</left><right>cS</right></production>
  <production><left>S</left><right>aA</right></production>
  <production><left>A</left><right>bA</right></production>
  <production><left>A</left><right>cA</right></production>
  <production><left>A</left><right/></production>
</structure>
